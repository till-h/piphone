# piphone SIP credentials
# Copy this file to .env and fill in your details

# Your SIP username (often your phone number or account ID)
SIP_USER=your_sip_username

# SIP domain (your provider's SIP server, e.g. sip.voip.ms, pstn.twilio.com)
SIP_DOMAIN=your_sip_domain

# SIP password / authentication password
SIP_PASSWORD=your_sip_password

# Outbound SIP proxy (usually same as SIP_DOMAIN, but can differ)
# Leave blank to use SIP_DOMAIN
SIP_OUTBOUND=

# Number format your provider expects for PSTN calls:
#   E164   = +447911123456  (recommended, works with most providers)
#   DIGITS = 447911123456   (no leading +)
NUMBER_FORMAT=E164

# Audio device (leave as "default" unless you have a specific USB audio device)
AUDIO_DEVICE=default
